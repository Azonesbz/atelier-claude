# Copier en `.env.production` SUR LE VPS et remplir. Jamais dans Git.
#
# Ce fichier ne sert qu'au RÔLE SERVICE. Aucune de ces valeurs ne descend sur
# la machine d'un acheteur.

# ── Clerk, instance de PRODUCTION ────────────────────────────────────────────
# ⚠️ L'instance de développement (`pk_test_…`, sur `.accounts.dev`) NE MARCHE PAS
# sur un domaine public. Il faut créer l'instance de production, poser les
# enregistrements DNS que Clerk réclame, puis relever ces deux clés.
#   clerk deploy   ·   https://dashboard.clerk.com → Configure → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Stripe, mode LIVE ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys — clé secrète, pas la publiable.
STRIPE_SECRET_KEY=

# https://dashboard.stripe.com/products — l'identifiant du tarif (price_…).
# Sans lui, la page qui vend n'affiche AUCUN prix : c'est le premier bloquant
# relevé par la revue, et le mécanisme refuse d'inventer un montant.
NEXT_PUBLIC_STRIPE_PRICE_ID=

# ── L'adresse publique ───────────────────────────────────────────────────────
# Sans barre finale. C'est elle que l'application locale d'un acheteur
# interrogera pour savoir si son achat existe.
NEXT_PUBLIC_ATELIER_SERVICE=https://orcha.vincentavz.com

# ── L'application OAuth du rôle local ────────────────────────────────────────
# La même que sur ta machine, mais côté instance de production. Le service en a
# besoin pour valider le jeton que l'application locale lui présente.
ATELIER_ACCES_CLIENT=

# ── La livraison : accès au dépôt privé après paiement ───────────────────────
# Le dépôt est privé, donc l'accès EST le produit livré. Sans ces deux
# variables, le paiement aboutit mais l'acheteur ne reçoit rien.

# Signature du webhook Stripe — https://dashboard.stripe.com/webhooks
# Créer un endpoint vers https://orcha.vincentavz.com/api/stripe/webhook,
# événement `checkout.session.completed`. Commence par whsec_.
STRIPE_WEBHOOK_SECRET=

# Jeton GitHub à portée fine, autorisé sur le dépôt, permission
# « Administration : lecture et écriture » — c'est elle qui permet d'inviter.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Le dépôt à ouvrir, sous la forme proprietaire/nom.
GITHUB_DEPOT=Azonesbz/atelier-claude
